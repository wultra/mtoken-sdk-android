{
    "_purpose": "This file is used as a definition file for the prepare-release script.",
    "_info": "It defines files that contains version number that should be updated during the release preparation.",
    "library": {
        "name": "mtoken-sdk-android",
        "type": "android-oss",
        "publishScript": "scripts/build-and-publish.sh central"
    },
    "files": [
        {
            "description": "Gradle properties file.",
            "path": "library/gradle.properties",
            "type": "version_replace",
            "match": "VERSION_NAME=%VERSION%"
        },
        {
            "description": "Example app pubspec file in the documentation.",
            "path": "docs/SDK-Integration.md",
            "type": "version_replace",
            "match": "implementation \"com.wultra.android.mtokensdk:wultra-mtoken-sdk:%VERSION%\""
        },
        {
            "description": "Compatibility in the documentation.",
            "path": "docs/SDK-Integration.md",
            "type": "versionstream_verify",
            "match": "`%VERSION_STREAM%`"
        },
        {
            "description": "Changelog for the wultra documentation.",
            "path": "docs/Changelog.md",
            "type": "version_verify",
            "match": "## %VERSION%"
        }
    ],
    "scripts": [
        
    ]
}